# Copie este archivo como .env y complete los valores. NUNCA suba el .env real al repositorio.

# --- Seguridad (obligatoria fuera del modo demo) ---
# Clave maestra: firma los tokens y cifra las credenciales guardadas. Minimo 32 caracteres aleatorios.
# Generar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se pierde o se cambia, las credenciales cifradas (conexion de la instancia e integraciones) dejan de poder leerse.
WMS_CLAVE_SECRETA=

# --- Publicacion ---
# URL con la que los usuarios abren el sistema. Se imprime dentro de los QR.
WMS_URL_PUBLICA=https://wms.miempresa.cl
WMS_DOMINIO=wms.miempresa.cl
# 1 cuando se sirve por HTTPS (la cookie de sesion solo viaja cifrada).
WMS_COOKIE_SEGURA=1
# Puerto del modo demo (docker-compose.yml).
WMS_PUERTO=8080

# --- Base de datos del ejemplo de produccion (docker-compose.produccion.yml) ---
BD_USUARIO=wms
BD_CLAVE=
BD_NOMBRE=wms
# 1 para incluir el controlador ODBC de SQL Server en la imagen del backend.
CON_SQLSERVER=0

# --- Opcionales del backend ---
# WMS_MODO_DEMO=1                 # datos ficticios sobre SQLite, sin asistente
# WMS_URL_BD=                     # URL SQLAlchemy explicita (omite el asistente de base de datos)
# WMS_MINUTOS_TOKEN_ACCESO=30
# WMS_DIAS_SESION=14
# WMS_INTENTOS_LOGIN=8
# WMS_VENTANA_LOGIN_SEGUNDOS=300
# WMS_PLANIFICADOR=1              # tareas internas: alertas y sincronizacion automatica
# WMS_ORIGENES_CORS=              # solo si el frontend se sirve desde otro origen
# WMS_ZONA_HORARIA=America/Santiago   # zona en que se cuentan los dias (vencimientos, antiguedad, consumo del dia)
